<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Helicopter - <%= helicopter.heliName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/management/helicopters">
        <i class="bi bi-airplane-engines me-2"></i>Helicopter Management
      </a>
      <div class="d-flex align-items-center">
        <a href="/management/helicopters" class="btn btn-outline-light btn-sm me-2">
          <i class="bi bi-arrow-left me-1"></i>Back to Fleet
        </a>
        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
          <i class="bi bi-box-arrow-right me-1"></i>Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
          <div class="card-header bg-primary text-white p-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Update Helicopter Details</h4>
          </div>
          <div class="card-body p-4">
            <% if (errorMsg) { %>
              <div class="alert alert-danger py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= errorMsg %>
              </div>
            <% } %>

            <form action="/management/helicopters/<%= helicopter._id %>" method="POST">
              <!-- heliName -->
              <div class="mb-3">
                <label for="heliName" class="form-label fw-semibold">Helicopter Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="heliName" name="heliName" value="<%= helicopter.heliName %>" required>
                <div class="form-text">Must contain at least two words, and the first letter of each word must be capitalized.</div>
              </div>

              <!-- imgWrapper -->
              <div class="mb-3">
                <label for="imgWrapper" class="form-label fw-semibold">Image URL <span class="text-danger">*</span></label>
                <input type="url" class="form-control" id="imgWrapper" name="imgWrapper" value="<%= helicopter.imgWrapper %>" required>
                <div class="form-text">Must be a valid web URL.</div>
              </div>

              <!-- price -->
              <div class="mb-3">
                <label for="price" class="form-label fw-semibold">Price (VND) <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="price" name="price" value="<%= helicopter.price %>" min="100000" required>
                <div class="form-text">Must be a number with a minimum of 6 digits (>= 100,000). (Equivalent to <%= (helicopter.price / 26000).toFixed(1) %> USD)</div>
              </div>

              <!-- manufacturer Select -->
              <div class="mb-3">
                <label for="manufacturer" class="form-label fw-semibold">Manufacturer <span class="text-danger">*</span></label>
                <select class="form-select" id="manufacturer" name="manufacturer" required>
                  <% manufacturers.forEach(m => { %>
                    <option value="<%= m._id %>" <%= helicopter.manufacturer && helicopter.manufacturer._id.toString() === m._id.toString() ? 'selected' : '' %>>
                      <%= m.manufacturer %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <!-- Switches -->
              <div class="row g-3 p-3 bg-light rounded border mb-4">
                <div class="col-md-6">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="editAdult" name="adult" <%= helicopter.adult ? 'checked' : '' %>>
                    <label class="form-check-label fw-semibold" for="editAdult">
                      <i class="bi bi-gender-male me-1"></i>Adult Audience
                    </label>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="editIsAssembly" name="isAssembly" <%= helicopter.isAssembly ? 'checked' : '' %>>
                    <label class="form-check-label fw-semibold" for="editIsAssembly">
                      <i class="bi bi-tools me-1"></i>Requires Assembly
                    </label>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between">
                <a href="/management/helicopters" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary fw-semibold px-4">Update Helicopter</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const adultSwitch = document.getElementById('editAdult');
    const assemblySwitch = document.getElementById('editIsAssembly');

    adultSwitch.addEventListener('change', function() {
      if (this.checked) {
        assemblySwitch.checked = true;
      }
    });

    assemblySwitch.addEventListener('change', function() {
      if (!this.checked && adultSwitch.checked) {
        alert('If Adult is true, then isAssembly must always be true.');
        this.checked = true;
      }
    });
  </script>
</body>
</html>

