# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG (.env) - BẮT BUỘC KHÔNG ĐƯỢC THIẾU
# Lưu ý: Đề thi FPTU quy định 0 điểm nếu hardcode connection string vào file JS!
# ============================================================================

# Cổng khởi chạy Server (thường là 9999 hoặc 5000 tùy đề bài)
PORT=9999

# Chuỗi kết nối MongoDB (Thay TênDatabase theo đề bài yêu cầu)
MONGO_URI=mongodb://127.0.0.1:27017/DatabaseName
MONGODB_URI=mongodb://127.0.0.1:27017/DatabaseName

# Khóa bí mật JWT (Dành cho bài thi yêu cầu xác thực JWT - ví dụ StudentCode@)
JWT_SECRET=your_jwt_secret_key@

# Khóa bí mật Session (Dành cho bài thi có giao diện EJS đăng nhập)
SESSION_SECRET=your_session_secret_key

