<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Helicopter Management - Card View</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    .heli-card-img {
      height: 200px;
      object-fit: cover;
      border-top-left-radius: calc(0.375rem - 1px);
      border-top-right-radius: calc(0.375rem - 1px);
    }
    .heli-card {
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .heli-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
  </style>
</head>
<body class="bg-light">
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/management/helicopters">
        <i class="bi bi-airplane-engines me-2"></i>Helicopter Management
      </a>
      <div class="d-flex align-items-center">
        <span class="navbar-text me-3 text-light">
          <i class="bi bi-person-circle me-1"></i> Welcome, <strong><%= user ? user.name : 'Member' %></strong>
        </span>
        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
          <i class="bi bi-box-arrow-right me-1"></i>Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <!-- Notifications -->
    <% if (notification) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= notification %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (errorMsg) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errorMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Header & Action -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1">Helicopter Fleet</h2>
        <p class="text-muted mb-0">Total available models: <%= helicopters.length %></p>
      </div>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addHelicopterModal">
        <i class="bi bi-plus-circle me-1"></i> Add New Helicopter
      </button>
    </div>

    <!-- Helicopters Card View (Grid of Cards) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% if (helicopters && helicopters.length > 0) { %>
        <% helicopters.forEach(heli => { %>
          <div class="col">
            <div class="card h-100 shadow-sm border-0 heli-card">
              <img src="<%= heli.imgWrapper %>" class="card-img-top heli-card-img" alt="<%= heli.heliName %>" onerror="this.src='https://via.placeholder.com/400x200?text=No+Image';">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title fw-bold text-dark text-truncate" title="<%= heli.heliName %>"><%= heli.heliName %></h5>
                
                <div class="mb-2">
                  <span class="badge bg-secondary me-1">
                    <i class="bi bi-building me-1"></i><%= heli.manufacturerName %>
                  </span>
                  
                  <!-- Adult Icon: Male (true) / Child (false) -->
                  <% if (heli.adult) { %>
                    <span class="badge bg-info text-dark" title="Adult Audience">
                      <i class="bi bi-gender-male me-1"></i>Adult (Male)
                    </span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark" title="Child Audience">
                      <i class="bi bi-person-arms-up me-1"></i>Child
                    </span>
                  <% } %>

                  <% if (heli.isAssembly) { %>
                    <span class="badge bg-success" title="Requires Assembly">
                      <i class="bi bi-tools me-1"></i>Assembly
                    </span>
                  <% } %>
                </div>

                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                  <div>
                    <span class="text-muted small d-block">Price (USD)</span>
                    <span class="fw-bold text-primary fs-5"><%= heli.priceUSD %> USD</span>
                    <span class="text-muted small d-block" style="font-size: 0.75rem;"><%= heli.priceVND.toLocaleString() %> VND</span>
                  </div>
                  <div class="btn-group">
                    <a href="/management/helicopters/<%= heli._id %>" class="btn btn-outline-secondary btn-sm" title="Edit / Detail">
                      <i class="bi bi-pencil-square"></i>
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteModal<%= heli._id %>">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Delete Confirmation Modal for each Helicopter -->
          <div class="modal fade" id="deleteModal<%= heli._id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                  <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  Are you sure you want to delete helicopter <strong>"<%= heli.heliName %>"</strong>? This action cannot be undone.
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <form action="/management/helicopters/<%= heli._id %>/delete" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <p class="text-muted">No helicopters found in database.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Add New Helicopter Modal Form -->
  <div class="modal fade" id="addHelicopterModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <form action="/management/helicopters" method="POST" id="addHelicopterForm">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add New Helicopter</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <!-- heliName -->
            <div class="mb-3">
              <label for="addHeliName" class="form-label fw-semibold">Helicopter Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addHeliName" name="heliName" placeholder="e.g. Armed Forces Lightning" required>
              <div class="form-text">Must contain at least two words, and the first letter of each word must be capitalized.</div>
            </div>

            <!-- imgWrapper -->
            <div class="mb-3">
              <label for="addImgWrapper" class="form-label fw-semibold">Image URL <span class="text-danger">*</span></label>
              <input type="url" class="form-control" id="addImgWrapper" name="imgWrapper" placeholder="https://example.com/image.jpg" required>
              <div class="form-text">Must be a valid web URL.</div>
            </div>

            <!-- price -->
            <div class="mb-3">
              <label for="addPrice" class="form-label fw-semibold">Price (VND) <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="addPrice" name="price" placeholder="e.g. 1709887" min="100000" required>
              <div class="form-text">Must be a number formatted with a minimum of 6 digits (>= 100,000).</div>
            </div>

            <!-- manufacturer Select -->
            <div class="mb-3">
              <label for="addManufacturer" class="form-label fw-semibold">Manufacturer <span class="text-danger">*</span></label>
              <select class="form-select" id="addManufacturer" name="manufacturer" required>
                <option value="" disabled selected>-- Select Manufacturer --</option>
                <% manufacturers.forEach(m => { %>
                  <option value="<%= m._id %>"><%= m.manufacturer %></option>
                <% }) %>
              </select>
            </div>

            <!-- Toggle Controls for adult and isAssembly -->
            <div class="row g-3 p-3 bg-light rounded border mb-3">
              <div class="col-md-6">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" id="addAdult" name="adult">
                  <label class="form-check-label fw-semibold" for="addAdult">
                    <i class="bi bi-gender-male me-1"></i>Adult Model
                  </label>
                  <div class="small text-muted">Toggle if intended for adult audience.</div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" id="addIsAssembly" name="isAssembly">
                  <label class="form-check-label fw-semibold" for="addIsAssembly">
                    <i class="bi bi-tools me-1"></i>Requires Assembly
                  </label>
                  <div class="small text-muted">If Adult is checked, Assembly is automatically required.</div>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary fw-semibold">Save Helicopter</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Rule: "If adult is true, then isAssembly must always be true."
    const adultToggle = document.getElementById('addAdult');
    const assemblyToggle = document.getElementById('addIsAssembly');

    adultToggle.addEventListener('change', function() {
      if (this.checked) {
        assemblyToggle.checked = true;
      }
    });

    assemblyToggle.addEventListener('change', function() {
      if (!this.checked && adultToggle.checked) {
        // Enforce rule: cannot uncheck assembly if adult is true
        alert('If Adult is true, then isAssembly must always be true.');
        this.checked = true;
      }
    });
  </script>
</body>
</html>

